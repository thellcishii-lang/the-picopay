generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model Store {
  id         String   @id @default(cuid())
  name       String
  settings   Json?    @default("{}")
  customers  Customer[]
  staff      Staff[]
  roles      Role[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Staff {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  name       String
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  isActive   Boolean  @default(true)
  lastLogin  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  name        String
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id])
  permissions Json
  isSystem    Boolean  @default(false)
  staff       Staff[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id           String        @id @default(cuid())
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id])
  name         String
  phone        String?       @unique
  email        String?       @unique
  memo         String?
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  storeId      String
  type         String
  amount       Int
  balanceAfter Int
  staffId      String?
  note         String?
  occurredAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
